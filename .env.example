NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-only secrets (never expose with NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=

# Stripe Checkout
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=usd

# WhatsApp Cloud API
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Set this to a currently supported Meta Graph API version, for example vXX.0.
WHATSAPP_API_VERSION=
WHATSAPP_DEFAULT_COUNTRY_CODE=
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_TEMPLATE_LANGUAGE=en_US
WHATSAPP_TEMPLATE_ORDER_CREATED=
WHATSAPP_TEMPLATE_ORDER_CONFIRMED=
WHATSAPP_TEMPLATE_ORDER_PROCESSING=
WHATSAPP_TEMPLATE_ORDER_SHIPPED=
WHATSAPP_TEMPLATE_ORDER_DELIVERED=
WHATSAPP_TEMPLATE_ORDER_CANCELLED=
WHATSAPP_TEMPLATE_ORDER_RETURNED=

# Used by the admin "Generate with AI" product feature (OpenAI API)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
